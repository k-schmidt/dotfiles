# Set proxy on Meta devvms (fwdproxy exists only on internal machines)
if [ "$(uname)" = "Linux" ] && [ -e /etc/fbwhoami ]; then
  export http_proxy=http://fwdproxy:8080
  export https_proxy=http://fwdproxy:8080
  # Uppercase too: Go and several Python clients only read that spelling.
  export HTTP_PROXY="$http_proxy"
  export HTTPS_PROXY="$https_proxy"

  # fwdproxy is the egress route to the *public* internet. Exporting a proxy
  # without an exclusion list sends internal hostnames there as well, where
  # they fail -- including the three endpoints dot_gitconfig.tmpl configures
  # (git.internal.tfbnw.net, mononoke-git-lfs.internal.tfbnw.net,
  # manifold.c2p.facebook.net). Leading dots so subdomains match across every
  # curl / requests / Go version.
  no_proxy="localhost,127.0.0.1,::1"
  no_proxy="$no_proxy,.internalfb.com,.facebook.com,.thefacebook.com"
  no_proxy="$no_proxy,.tfbnw.net,.facebook.net,.fbcdn.net,.fb.com"
  no_proxy="$no_proxy,.fbinfra.net,fburl.com"
  export no_proxy
  export NO_PROXY="$no_proxy"
fi

# If ~/.bashrc exists, load it (keeps Bash consistent across shells)
if [ -f ~/.bashrc ]; then
  source ~/.bashrc
fi