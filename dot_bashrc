########## PATH & ENVIRONMENT ##########

# Kept deliberately in step with dot_zshrc. zsh is the interactive shell, but
# bash still runs every `bash -lc`, every script that opens an editor, and
# anything spawned by a tool that ignores $SHELL. When the two files disagree,
# those paths silently get a different toolchain than the one you are looking at.

# Homebrew paths. Apple Silicon first, Intel fallback for an older Mac.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

# Default editor. nvim for git/commit buffers -- `code --wait` is fine
# interactively but hangs in any context where no VS Code window is listening.
export EDITOR="nvim"
export VISUAL="nvim"

########## HISTORY ##########

export HISTCONTROL=ignoredups:erasedups
export HISTSIZE=50000
export HISTFILESIZE=50000
shopt -s histappend
PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

########## ALIASES ##########

# Navigation
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -1'
alias ..='cd ..'
alias ...='cd ../..'

# Git
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'

# tmux
alias t="tmux"
alias ta="tmux attach -t"
alias tn="tmux new -s"
alias tl="tmux ls"
alias tk="tmux kill-session -t"
# Attach if the session exists, create it otherwise, so one command covers
# both cases and ta/tn stop erroring depending on which state you are in.
alias ts="tmux new -A -s"

# chezmoi
alias cza="chezmoi apply"
alias czu="chezmoi update"
alias cze="chezmoi edit"
# `chezmoi cd` opens a subshell you have to exit; this just moves the current
# shell to the source directory.
czcd() { cd "$(chezmoi source-path)" || return; }

# neovim
alias v="nvim"
alias vi="nvim"
alias vim="nvim"

########## PROMPT ##########

PS1='\u@\h:\w\$ '

########## FINALIZATION ##########

# FZF. Inlined here rather than sourced from ~/.fzf.bash so both shells set it
# up identically -- fzf's generated rc file also appended a Homebrew keg path,
# which was the one thing making bash and zsh resolve different PATHs. Late in
# the file on purpose: the probe needs the PATH block above to have run.
# Homebrew's fzf is always well past 0.48, so `--bash` is safe.
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi

# Zoxide (smarter cd)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

# Volta (Node version manager). After the base PATH so its shims win over
# /usr/local/bin.
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# Ensure Homebrew takes priority over Volta
if [[ -d /opt/homebrew/bin ]]; then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi
