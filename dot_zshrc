# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

########## OH-MY-ZSH CONFIGURATION ##########

# Path to your oh-my-zsh installation.
export ZSH="$HOME/.oh-my-zsh"

# Set the theme to Powerlevel10k
ZSH_THEME="powerlevel10k/powerlevel10k"

# Define plugins here. OMZ will handle the sourcing and paths for you.
# This fixes the "logic mismatch" error you were seeing.
plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
)

# Load Oh My Zsh (This must happen AFTER defining plugins and theme)
source $ZSH/oh-my-zsh.sh

########## PATH & ENVIRONMENT ##########

# Homebrew paths. Apple Silicon first, Intel fallback for an older Mac.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# Add custom bin directories
export PATH="$HOME/bin:$HOME/.local/bin:/usr/local/bin:$PATH"

# Default editor. nvim for git/commit buffers -- `code --wait` is fine
# interactively but hangs in any context where no VS Code window is listening.
export EDITOR="nvim"
export VISUAL="nvim"

########## SETTINGS & ALIASES ##########

# History
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt share_history
setopt append_history
setopt hist_ignore_dups
setopt hist_reduce_blanks

# Navigation
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups

# Aliases
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -1'
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git pull'
alias ..='cd ..'
alias ...='cd ../..'

# tmux
alias t="tmux"
alias ta="tmux attach -t"
alias tn="tmux new -s"
alias tl="tmux ls"
alias tk="tmux kill-session -t"
# Attach if the session exists, create it otherwise, so one command covers
# both cases and ta/tn stop erroring depending on which state you are in.
alias ts="tmux new -A -s"

# chezmoi
alias cza="chezmoi apply"
alias czu="chezmoi update"
alias cze="chezmoi edit"
# `chezmoi cd` opens a subshell you have to exit; this just moves the current
# shell to the source directory.
czcd() { cd "$(chezmoi source-path)" || return; }

# neovim
alias v="nvim"
alias vi="nvim"
alias vim="nvim"

# Quick Config Edits
alias zshrc='$EDITOR ~/.zshrc'
alias src='source ~/.zshrc'

# SSH shortcuts
alias macmini='ssh kyleschmidt@Kyles-Mac-mini.local'

########## FINALIZATION ##########

# FZF setup. Homebrew's fzf is always well past 0.48, so `--zsh` is safe.
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Zoxide (smarter cd)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Volta (Node version manager)
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# Ensure Homebrew takes priority over Volta
if [[ -d /opt/homebrew/bin ]]; then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi
