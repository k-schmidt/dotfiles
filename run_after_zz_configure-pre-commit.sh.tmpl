#!/bin/bash

set -u

if ! command -v pre-commit >/dev/null 2>&1; then
	echo "pre-commit not found. Skipping hook installation."
	exit 0
fi

# Resolved at template render time. Shelling out to `chezmoi` here would
# deadlock: the parent `chezmoi apply` already holds the persistent state lock.
source_repository={{ .chezmoi.workingTree | quote }}
if ! git -C "$source_repository" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	echo "Chezmoi source is not a Git repository. Skipping pre-commit hook installation."
	exit 0
fi

cd "$source_repository" || exit 1

# Reinstall only when the hook is absent, was written by something other than
# pre-commit, or names an interpreter that no longer exists -- a Homebrew
# Python bump leaves the templated INSTALL_PYTHON path dangling.
hook_path="$(git rev-parse --git-path hooks/pre-commit)"
hook_interpreter=""
if [ -f "$hook_path" ]; then
	hook_interpreter="$(sed -n 's/^INSTALL_PYTHON=//p' "$hook_path")"
fi

if [ -n "$hook_interpreter" ] &&
	grep -q "generated by pre-commit" "$hook_path" &&
	[ -x "$hook_interpreter" ]; then
	exit 0
fi

echo "Installing the dotfiles pre-commit hook..."
pre-commit install
