#!/bin/bash

# run_onchange_after_install-volta-packages.sh.tmpl

{{- $volta := .packages.volta.common -}}

# This hash comment forces the script to re-run whenever the package list
# changes:
# packages: {{ $volta | quote }}

# No `-e`: one unavailable package must not abort the run or the wider apply.
# Failures are collected and reported below.
set -ufo pipefail

# 1. Ensure Volta is in the PATH for this script session
# (Crucial for fresh installs where the shell hasn't restarted yet)
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

# Check if Volta is actually installed before proceeding
if ! command -v volta &> /dev/null; then
    echo "Volta not found. Skipping package installation."
    exit 0
fi
echo "Installing/Updating Volta packages..."

# 2. Iterate through the list resolved above from .chezmoidata.toml
VOLTA_FAILED=()
{{ range $volta -}}
volta install {{ . | quote }} || VOLTA_FAILED+=({{ . | quote }})
{{ end }}
if [ ${#VOLTA_FAILED[@]} -gt 0 ]; then
    echo "Volta packages failed: ${VOLTA_FAILED[*]}"
else
    echo "Volta packages installed."
fi
