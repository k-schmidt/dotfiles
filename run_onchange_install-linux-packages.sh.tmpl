#!/bin/bash
{{ if eq .chezmoi.os "linux" -}}

# run_onchange_install-linux-packages.sh.tmpl
#
# Linux devserver counterpart to run_onchange_install-packages.sh (Homebrew on
# macOS). dnf covers what the repos carry; everything else is fetched from
# upstream releases into ~/.local.
#
# Re-runs whenever the resolved package list changes:
# dnf packages: {{ .packages.dnf.linux | quote }}

# Deliberately NOT `set -e`. A single unavailable package must not abort the
# whole `chezmoi apply` and block the scripts that run after this one. Failures
# are collected and reported, and the script always exits 0.
set -uo pipefail

FAILED=()

{{ template "linux-net.sh" . }}

case "$(uname -m)" in
    x86_64)  NVIM_ARCH="linux-x86_64" ;;
    aarch64) NVIM_ARCH="linux-arm64" ;;
    *)       NVIM_ARCH="" ;;
esac

mkdir -p "$HOME/.local/bin"

# --- dnf packages -----------------------------------------------------------
if ! command -v dnf >/dev/null 2>&1; then
    echo "dnf not found. Skipping system package installation."
elif ! sudo -n true 2>/dev/null; then
    echo "Passwordless sudo unavailable. Skipping dnf; run this manually:"
    echo "  sudo dnf install -y {{ .packages.dnf.linux | join " " }}"
else
    echo "==> Installing system packages with dnf"
    for pkg in {{ range .packages.dnf.linux }}{{ . | quote }} {{ end }}; do
        if rpm -q "$pkg" >/dev/null 2>&1; then
            echo "  Using $pkg"
        elif sudo dnf install -y "$pkg" >/dev/null 2>&1; then
            echo "  Installed $pkg"
        else
            echo "  FAILED $pkg"
            FAILED+=("$pkg")
        fi
    done
fi

# fd-find installs the binary as `fdfind` on some distros. Shim it so muscle
# memory and any tooling expecting `fd` keep working.
if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
    ln -sf "$(command -v fdfind)" "$HOME/.local/bin/fd"
    echo "  Linked fdfind -> ~/.local/bin/fd"
fi

# --- neovim from tarball ----------------------------------------------------
# The config needs 0.10+ (lazy.nvim, blink.cmp, conform, treesitter main), well
# ahead of the distro build. Delete ~/.local/nvim to force a re-install.
NVIM_PREFIX="$HOME/.local/nvim"
NVIM_BIN="$HOME/.local/bin/nvim"

nvim_is_current() {
    local v
    v="$("$NVIM_BIN" --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+')" || return 1
    [ -n "$v" ] || return 1
    awk -v v="$v" 'BEGIN { split(v, p, "."); exit !(p[1] > 0 || p[2] >= 10) }'
}

if [ -x "$NVIM_BIN" ] && nvim_is_current; then
    echo "==> Using neovim $("$NVIM_BIN" --version | head -1)"
elif [ -z "$NVIM_ARCH" ]; then
    echo "==> Unsupported architecture $(uname -m). Skipping neovim."
    FAILED+=("neovim (unsupported arch)")
elif ! net_resolve; then
    FAILED+=("neovim (no network route)")
else
    echo "==> Installing neovim from official tarball"
    TMP="$(mktemp -d)"
    URL="https://github.com/neovim/neovim/releases/download/stable/nvim-${NVIM_ARCH}.tar.gz"
    if net_fetch "$URL" "$TMP/nvim.tar.gz" && tar -xzf "$TMP/nvim.tar.gz" -C "$TMP"; then
        rm -rf "$NVIM_PREFIX"
        mv "$TMP/nvim-${NVIM_ARCH}" "$NVIM_PREFIX"
        ln -sf "$NVIM_PREFIX/bin/nvim" "$NVIM_BIN"
        echo "  Installed $("$NVIM_BIN" --version | head -1)"
    else
        echo "  FAILED to fetch neovim from $URL"
        FAILED+=("neovim")
    fi
    rm -rf "$TMP"
fi

# --- volta ------------------------------------------------------------------
# Homebrew provides this on macOS. Not in the dnf repos, so use the upstream
# installer. --skip-setup because zshrc already exports VOLTA_HOME and PATH.
# This must succeed before the run_onchange_after_ volta script, which runs
# later in the same apply and is currently a no-op without it.
#
# Fetched as a plain tarball rather than through get.volta.sh. The installer
# runs its own curl, which cannot present the x509 client cert, so it fails
# outright when the only route out is the mTLS proxy — which is exactly what
# happened on the devserver while every net_fetch download succeeded.
export VOLTA_HOME="$HOME/.volta"
if [ -x "$VOLTA_HOME/bin/volta" ]; then
    echo "==> Using volta $("$VOLTA_HOME/bin/volta" --version 2>/dev/null)"
elif [ "$(uname -m)" != "x86_64" ]; then
    echo "==> Skipping volta on $(uname -m): only the x86_64 asset is verified"
    FAILED+=("volta (unsupported arch)")
elif ! net_resolve; then
    FAILED+=("volta (no network route)")
else
    volta_tag="$(gh_latest_tag volta-cli/volta || true)"
    if [ -z "$volta_tag" ]; then
        echo "  FAILED volta (could not resolve the latest tag)"
        FAILED+=("volta")
    else
        echo "==> Installing volta $volta_tag"
        TMP="$(mktemp -d)"
        volta_url="https://github.com/volta-cli/volta/releases/download/${volta_tag}/volta-${volta_tag#v}-linux.tar.gz"
        if net_fetch "$volta_url" "$TMP/volta.tar.gz" \
           && tar -xzf "$TMP/volta.tar.gz" -C "$TMP" \
           && [ -f "$TMP/volta" ]; then
            mkdir -p "$VOLTA_HOME/bin"
            for b in volta volta-shim volta-migrate; do
                [ -f "$TMP/$b" ] && install -m 0755 "$TMP/$b" "$VOLTA_HOME/bin/$b"
            done
            # `volta setup` builds the ~/.volta layout and shims, but it also
            # appends VOLTA_HOME lines to whichever shell profile matches
            # $SHELL. Those files are chezmoi-managed, and chezmoi refuses to
            # touch a target that changed since it last wrote it -- so an
            # unguarded setup poisons every later `chezmoi apply` with
            # "has changed since chezmoi last wrote it". zshrc and bashrc
            # already export VOLTA_HOME, so the appended lines buy nothing.
            # Snapshot, let setup run, put the originals back.
            VOLTA_GUARD="$(mktemp -d)"
            for p in .zshrc .bashrc .bash_profile; do
                [ -f "$HOME/$p" ] && cp -p "$HOME/$p" "$VOLTA_GUARD/$p"
            done
            "$VOLTA_HOME/bin/volta" setup >/dev/null 2>&1
            for p in .zshrc .bashrc .bash_profile; do
                [ -f "$VOLTA_GUARD/$p" ] || continue
                cmp -s "$VOLTA_GUARD/$p" "$HOME/$p" && continue
                cp -p "$VOLTA_GUARD/$p" "$HOME/$p"
                echo "  Reverted volta setup's edit to ~/$p (chezmoi owns it)"
            done
            rm -rf "$VOLTA_GUARD"
            echo "  Installed volta $("$VOLTA_HOME/bin/volta" --version 2>/dev/null)"
        else
            echo "  FAILED volta from $volta_url"
            FAILED+=("volta")
        fi
        rm -rf "$TMP"
    fi
fi

# --- upstream release binaries ----------------------------------------------
# Everything in the Brewfile that the dnf repos do not carry. Asset names and
# archive layouts were read off the GitHub API rather than guessed; only the
# x86_64 assets were confirmed, so other architectures are skipped instead of
# being fed a URL that may not exist.
#
# install_release <binary> <url> <kind> [member]
#   kind    raw | gz | targz | zip
#   member  path to the binary inside the archive (defaults to <binary>)
install_release() {
    local name="$1" url="$2" kind="$3" member="${4:-}"
    [ -n "$member" ] || member="$name"

    if command -v "$name" >/dev/null 2>&1; then
        echo "==> Using $name ($(command -v "$name"))"
        return 0
    fi
    if [ -z "$url" ]; then
        echo "  FAILED $name (could not resolve a download URL)"
        FAILED+=("$name")
        return 1
    fi

    echo "==> Installing $name"
    local tmp ok=1
    tmp="$(mktemp -d)"
    case "$kind" in
        raw)   net_fetch "$url" "$tmp/$member" || ok=0 ;;
        # A bare gzipped binary, not an archive: decompress to a named path
        # rather than letting gunzip pick one by stripping the suffix.
        gz)    { net_fetch "$url" "$tmp/a.gz" && gzip -dc "$tmp/a.gz" > "$tmp/$member"; } || ok=0 ;;
        targz) { net_fetch "$url" "$tmp/a.tar.gz" && tar -xzf "$tmp/a.tar.gz" -C "$tmp"; } || ok=0 ;;
        zip)   { net_fetch "$url" "$tmp/a.zip" && unzip -oq "$tmp/a.zip" -d "$tmp"; } || ok=0 ;;
    esac

    if [ "$ok" -eq 1 ] && [ -f "$tmp/$member" ]; then
        install -m 0755 "$tmp/$member" "$HOME/.local/bin/$name"
        echo "  Installed $name"
    else
        echo "  FAILED $name from $url"
        FAILED+=("$name")
        ok=0
    fi
    rm -rf "$tmp"
    [ "$ok" -eq 1 ]
}

if [ "$(uname -m)" != "x86_64" ]; then
    echo "==> Skipping release binaries on $(uname -m): only x86_64 assets are verified"
elif ! net_resolve; then
    FAILED+=("release binaries (no network route)")
else
    # Stable "latest/download" URLs: no version in the asset name.
    install_release direnv \
        "https://github.com/direnv/direnv/releases/latest/download/direnv.linux-amd64" raw
    install_release difft \
        "https://github.com/Wilfred/difftastic/releases/latest/download/difft-x86_64-unknown-linux-gnu.tar.gz" targz
    install_release stylua \
        "https://github.com/JohnnyMorganz/StyLua/releases/latest/download/stylua-linux-x86_64.zip" zip
    # nvim-treesitter (main) shells out to a bare `tree-sitter` for both
    # `generate` and `build` on every parser, and its health check demands
    # >= 0.26.1 -- far past anything a distro would carry. Shipped as a lone
    # gzipped binary rather than a tarball, hence the gz kind above.
    install_release tree-sitter \
        "https://github.com/tree-sitter/tree-sitter/releases/latest/download/tree-sitter-linux-x64.gz" gz
    install_release uv \
        "https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-unknown-linux-gnu.tar.gz" targz \
        "uv-x86_64-unknown-linux-gnu/uv"

    # These two embed the version in the filename, so resolve the tag first.
    # lazygit lowercased "linux" in its asset name as of v0.64.x.
    lg_tag="$(gh_latest_tag jesseduffield/lazygit || true)"
    lg_url=""
    [ -n "$lg_tag" ] && lg_url="https://github.com/jesseduffield/lazygit/releases/download/${lg_tag}/lazygit_${lg_tag#v}_linux_x86_64.tar.gz"
    install_release lazygit "$lg_url" targz

    sh_tag="$(gh_latest_tag mvdan/sh || true)"
    sh_url=""
    [ -n "$sh_tag" ] && sh_url="https://github.com/mvdan/sh/releases/download/${sh_tag}/shfmt_${sh_tag}_linux_amd64"
    install_release shfmt "$sh_url" raw
fi

# --- Summary ----------------------------------------------------------------
if [ ${#FAILED[@]} -gt 0 ]; then
    echo
    echo "Linux package install finished with ${#FAILED[@]} failure(s):"
    printf '  - %s\n' "${FAILED[@]}"
    echo "Everything else succeeded; continuing so later scripts still run."
fi

exit 0

{{ end -}}
