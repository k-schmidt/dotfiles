#!/bin/bash

# dot_config/brew/Brewfile hash: {{ include "dot_config/brew/Brewfile" | sha256sum }}

if command -v brew >/dev/null 2>&1; then
	# Adopt manually installed applications before Brew Bundle manages them.
	# If an app cannot be adopted, leave it untouched and let Brew report the
	# conflict rather than overwriting it.
	adopt_cask() {
		local cask_name="$1"
		local app_path="$2"

		if [[ -d "$app_path" ]] && ! brew list --cask "$cask_name" >/dev/null 2>&1; then
			brew install --cask --adopt "$cask_name" || true
		fi
	}

	adopt_cask chatgpt /Applications/ChatGPT.app
	adopt_cask 1password /Applications/1Password.app

	echo "🍺  Brewfile change detected. Installing packages..."
	brew bundle --file=~/.config/brew/Brewfile
else
	echo "Error: Homebrew not found. Skipping package installation."
fi
